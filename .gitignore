# Видеограф-пак — что НЕ попадает в публичный репо

# Память и настройки едут в паке только как пустые шаблоны.
# Не наполняй их личными данными в публичном форке.
*.env
.env.*
!.env.example

# Remotion: зависимости и рендеры (ставятся/генерятся на месте)
agent/remotion-studio/node_modules/
agent/remotion-studio/out/
node_modules/

